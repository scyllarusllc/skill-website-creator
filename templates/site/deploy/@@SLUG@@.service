# Install: sudo cp deploy/@@SLUG@@.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now @@SLUG@@
# Adjust WorkingDirectory/ExecStart to where the project lives (and add User=/Group= to run unprivileged).
[Unit]
Description=@@NAME@@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/@@SLUG@@
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/@@SLUG@@/.venv/bin/python cli.py serve --port @@PORT@@
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
