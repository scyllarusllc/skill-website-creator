# Copy to .env, then chmod 600 .env. Real values never go in git.
# The public address of the site. https:// turns on Secure cookies; Google sign-in redirects back here.
@@ENV@@_ORIGIN=http://127.0.0.1:@@PORT@@
# The one administrator. Make the hash with:  make hash-password
@@ENV@@_ADMIN_EMAIL=admin@example.test
@@ENV@@_ADMIN_PASSWORD_HASH=
# Optional "Continue with Google". Needs the admin email above to be that Google account.
# Add <origin>/auth/google/callback as an authorised redirect URI in Google Cloud Console.
@@ENV@@_GOOGLE_CLIENT_ID=
@@ENV@@_GOOGLE_CLIENT_SECRET=
# Optional: where the SQLite file lives (default data/@@SLUG@@.sqlite3)
# @@ENV@@_DB=
